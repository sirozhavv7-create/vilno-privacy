---
import Base from '../layouts/Base.astro';
import { faq } from '../data/faq.mjs';

const title = 'Що таке Вільно — питання й відповіді | FAQ';
const description =
  'Що таке Вільно, скільки коштує, хто такий Віль, що буде після зриву і чи підходить застосунок для вейпа — відповіді на найчастіші питання.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Base title={title} description={description} path="/faq" jsonLd={jsonLd}>
  <section>
    <div class="container">
      <h1 class="section-title">Питання й відповіді</h1>
      <p class="section-lead">
        Усе, що зазвичай питають про Вільно. Не знайшов відповіді — напиши нам,
        пошта у футері.
      </p>
      <div class="faq-list">
        {faq.map((item) => (
          <details class="faq-item" id={item.id}>
            <summary>{item.q}</summary>
            <div class="answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
      <p class="faq-more">
        <a href="/get" class="btn">Завантажити Вільно</a>
      </p>
    </div>
  </section>
</Base>
