---
import { PLAY_URL, APPSTORE_URL, IOS_LIVE } from '../config.mjs';
import { t } from '../i18n/uk.mjs';
---

<div class="store-buttons">
  <a href={PLAY_URL} class="store-btn" rel="noopener">
    <svg width="26" height="28" viewBox="0 0 24 26" fill="none" aria-hidden="true">
      <path d="M2 1.5v23c0 .6.7 1 1.2.7l.3-.2L16 13 3.5 1c-.6-.4-1.5 0-1.5.5z" fill="#4bd0a0"></path>
      <path d="M16 13 3.5 1l13.9 8 3 1.7L16 13z" fill="#f9d423"></path>
      <path d="M16 13 3.5 25l13.9-8 3-1.7L16 13z" fill="#f05c5c"></path>
      <path d="M20.4 10.7 17.4 9l-1.4 4 1.4 4 3-1.7c1.1-.7 1.1-2 0-2.6z" fill="#8bb8f0"></path>
    </svg>
    <span class="store-text">
      <span class="store-small">{t.store.getOn}</span>
      <span class="store-big">{t.store.googlePlay}</span>
    </span>
  </a>

  {IOS_LIVE ? (
    <a href={APPSTORE_URL} class="store-btn" rel="noopener">
      <svg width="24" height="28" viewBox="0 0 24 28" fill="currentColor" aria-hidden="true">
        <path d="M19.7 14.8c0-3.1 2.5-4.6 2.6-4.7-1.4-2.1-3.7-2.4-4.5-2.4-1.9-.2-3.7 1.1-4.6 1.1-1 0-2.4-1.1-4-1.1-2 0-3.9 1.2-5 3-2.1 3.7-.5 9.2 1.5 12.2 1 1.5 2.2 3.1 3.8 3 1.6-.1 2.1-1 4-1s2.4 1 4 1c1.7 0 2.7-1.5 3.7-3 1.2-1.7 1.7-3.4 1.7-3.5-.1 0-3.2-1.2-3.2-4.6zM16.6 5.6c.8-1 1.4-2.5 1.3-3.9-1.2 0-2.7.8-3.6 1.8-.8.9-1.5 2.4-1.3 3.8 1.4.1 2.7-.7 3.6-1.7z"></path>
      </svg>
      <span class="store-text">
        <span class="store-small">{t.store.downloadOn}</span>
        <span class="store-big">{t.store.appStore}</span>
      </span>
    </a>
  ) : (
    <span class="store-btn disabled" aria-disabled="true">
      <svg width="24" height="28" viewBox="0 0 24 28" fill="currentColor" aria-hidden="true">
        <path d="M19.7 14.8c0-3.1 2.5-4.6 2.6-4.7-1.4-2.1-3.7-2.4-4.5-2.4-1.9-.2-3.7 1.1-4.6 1.1-1 0-2.4-1.1-4-1.1-2 0-3.9 1.2-5 3-2.1 3.7-.5 9.2 1.5 12.2 1 1.5 2.2 3.1 3.8 3 1.6-.1 2.1-1 4-1s2.4 1 4 1c1.7 0 2.7-1.5 3.7-3 1.2-1.7 1.7-3.4 1.7-3.5-.1 0-3.2-1.2-3.2-4.6zM16.6 5.6c.8-1 1.4-2.5 1.3-3.9-1.2 0-2.7.8-3.6 1.8-.8.9-1.5 2.4-1.3 3.8 1.4.1 2.7-.7 3.6-1.7z"></path>
      </svg>
      <span class="store-text">
        <span class="badge-soon">{t.store.soon}</span>
        <span class="store-big">{t.store.appStore}</span>
      </span>
    </span>
  )}
</div>
