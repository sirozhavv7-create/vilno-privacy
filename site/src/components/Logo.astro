---
import { APP_NAME } from '../config.mjs';

interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<img
  src="/icon.png"
  alt={`Іконка застосунку ${APP_NAME}`}
  width={size}
  height={size}
  class="logo-icon"
  style={`--logo-size: ${size}px`}
/>

<style>
  .logo-icon {
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: 10px;
    flex: none;
  }
</style>
