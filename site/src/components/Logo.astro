---
import { APP_NAME } from '../config.mjs';

interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<img
  src="/logo-64.png"
  alt={`Іконка застосунку ${APP_NAME}`}
  width={size}
  height={size}
  class="logo-icon"
  style={`--logo-size: ${size}px`}
/>

<style>
  .logo-icon {
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: 10px;
    flex: none;
    /* Іконка на кремовому тлі зливається з фоном сайту —
       тонка шавлієва рамка і легка підкладка проявляють контур.
       box-sizing: border-box (глобальний) тримає розмір тим самим. */
    border: 1px solid color-mix(in srgb, var(--sage) 40%, transparent);
    background: color-mix(in srgb, var(--sage) 10%, transparent);
  }
</style>
